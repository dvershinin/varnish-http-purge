# A set of files you probably don't want in your WordPress.org distribution

# Version control and CI/CD
.git
.gitignore
.github
.gitlab-ci.yml
.travis.yml
.circleci
bitbucket-pipelines.yml

# IDE and editor files
.cursor
.editorconfig
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Development tooling
.pre-commit-config.yaml
Makefile
todo.txt

# PHP static analysis and linting
phpstan.neon
phpstan-bootstrap.php
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
multisite.xml
multisite.xml.dist

# JavaScript/Node tooling
Gruntfile.js
package.json
package-lock.json
yarn.lock
node_modules

# PHP dependencies
composer.json
composer.lock
vendor
wpcs

# Test suites
tests
behat.yml
bin

# Build artifacts and temp files
*.sql
*.tar.gz
*.zip
.DS_Store
Thumbs.db

# Documentation (WordPress.org uses readme.txt)
README.md
.distignore
wp-cli.local.yml